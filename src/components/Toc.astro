---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props {
	headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
	items.length > 0 && (
		<nav class="toc" aria-label="目次">
			<span class="toc-title">目次</span>
			<ol>
				{items.map((h) => (
					<li>
						<a href={`#${h.slug}`}>{h.text}</a>
					</li>
				))}
			</ol>
		</nav>
	)
}
