---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticleBanner from '../components/ArticleBanner.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Toc from '../components/Toc.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	plain?: boolean;
	id?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroEmoji,
	category,
	related,
	headings = [],
	plain = false,
	id,
} = Astro.props;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Organization',
		name: `${SITE_TITLE}編集部`,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': Astro.url.href,
	},
};
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} ogType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 900px;
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose :global(table) {
				display: block;
				overflow-x: auto;
				white-space: nowrap;
				-webkit-overflow-scrolling: touch;
				border-collapse: collapse;
				mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
				-webkit-mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
			}
			/* Comparison tables run 4-5 columns; at body size they need ~700px
			   of scroll on a 358px phone, which leaves the price column off
			   the first view. Dropping to 14px is still comfortably readable
			   and buys back enough width to reach it in one short swipe. */
			@media (max-width: 480px) {
				.prose :global(table) {
					font-size: 0.85em;
				}
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.5em 0.6em;
				border: 1px solid rgb(var(--gray-light));
				/* nowrap on every cell is what pushed the price column ~480px
				   off a 390px screen: a single prose cell ("奥行45cm以下の机／
				   立ち作業も") claimed 350px on its own. keep-all gives the same
				   protection nowrap was there for -- Japanese never breaks
				   mid-word -- while still wrapping at spaces, ／ and brackets. */
				white-space: normal;
				word-break: keep-all;
				max-width: 11em;
			}
			/* Product-name columns are the longest cells in every comparison
			   table, and nowrap let them eat 295px of a 358px phone screen --
			   pushing the price column right off the initial view. Let just
			   that column wrap; the rest stay nowrap so the table keeps its
			   readable horizontal-scroll shape instead of collapsing. */
			/* The first column identifies the row, so it stays pinned while
			   the rest scrolls -- otherwise scrolling to the price column
			   leaves you looking at numbers with no idea which product they
			   belong to. */
			.prose :global(th:first-child),
			.prose :global(td:first-child) {
				position: sticky;
				left: 0;
				z-index: 1;
				max-width: 9em;
				background: #fff;
			}
			.prose :global(thead th:first-child) {
				background: var(--accent);
			}
			.prose :global(tbody tr:nth-child(even) td:first-child) {
				background: #f3f4f8;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.ad-disclosure {
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-align: center;
				margin: -0.5em 0 1.5em;
			}
			@media (max-width: 480px) {
				.title h1 {
					font-size: 1.75em;
				}
				/* main already supplies the phone gutter; don't inset again. */
				main {
					width: 100%;
				}
				.prose {
					max-width: 100%;
					margin: 0;
					padding: 0;
				}
			}
			.category-pill {
				display: inline-block;
				background: var(--accent);
				color: #fff;
				font-family: var(--font-heading);
				font-weight: 700;
				font-size: 0.8em;
				padding: 0.3em 1em;
				border-radius: 999px;
				margin-bottom: 0.8em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{!plain && (
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
						{!heroImage && <ArticleBanner title={title} emoji={heroEmoji} />}
					</div>
				)}
				<div class="prose">
					<div class="title">
						{!plain && (
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											最終更新日: <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
						)}
						{category && <span class="category-pill">{category}</span>}
						<h1>{title}</h1>
						<hr />
					</div>
					{
						!plain && (
							<p class="ad-disclosure">
								本ページはプロモーションが含まれています。当サイトはAmazonアソシエイト・プログラムの参加者です。
							</p>
						)
					}
					<Toc headings={headings} />
					<slot />
					{!plain && id && <RelatedPosts currentId={id} slugs={related} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
