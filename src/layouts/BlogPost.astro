---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticleBanner from '../components/ArticleBanner.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Toc from '../components/Toc.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	plain?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroEmoji,
	category,
	headings = [],
	plain = false,
} = Astro.props;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Organization',
		name: `${SITE_TITLE}編集部`,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': Astro.url.href,
	},
};
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 900px;
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose :global(table) {
				display: block;
				overflow-x: auto;
				white-space: nowrap;
				-webkit-overflow-scrolling: touch;
				border-collapse: collapse;
				mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
				-webkit-mask-image: linear-gradient(to right, black calc(100% - 28px), transparent 100%);
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.5em 0.8em;
				border: 1px solid rgb(var(--gray-light));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.ad-disclosure {
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-align: center;
				margin: -0.5em 0 1.5em;
			}
			@media (max-width: 480px) {
				.title h1 {
					font-size: 1.75em;
				}
			}
			.category-pill {
				display: inline-block;
				background: var(--accent);
				color: #fff;
				font-family: var(--font-heading);
				font-weight: 700;
				font-size: 0.8em;
				padding: 0.3em 1em;
				border-radius: 999px;
				margin-bottom: 0.8em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{!plain && (
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
						{!heroImage && <ArticleBanner title={title} emoji={heroEmoji} />}
					</div>
				)}
				<div class="prose">
					<div class="title">
						{!plain && (
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											最終更新日: <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
						)}
						{category && <span class="category-pill">{category}</span>}
						<h1>{title}</h1>
						<hr />
					</div>
					{
						!plain && (
							<p class="ad-disclosure">
								本ページはプロモーションが含まれています。当サイトはAmazonアソシエイト・プログラムの参加者です。
							</p>
						)
					}
					<Toc headings={headings} />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
