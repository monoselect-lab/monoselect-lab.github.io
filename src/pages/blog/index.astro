---
import { getCollection } from 'astro:content';
import ArticleBanner from '../../components/ArticleBanner.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="list-main">
			<h1>記事一覧</h1>
			<ul class="post-grid">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage ? (
									<img src={post.data.heroImage.src} alt="" />
								) : (
									<ArticleBanner title={post.data.title} emoji={post.data.heroEmoji} />
								)}
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
<style>
	.list-main {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 2em 1em 3em;
	}
	.post-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.4em;
	}
	.post-grid li a {
		display: block;
		text-decoration: none;
		color: inherit;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		transition: transform 0.15s ease;
	}
	.post-grid li a:hover {
		transform: translateY(-3px);
	}
	.post-grid img {
		width: 100%;
		aspect-ratio: 1200 / 630;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}
	.post-title {
		display: block;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 1em;
		padding: 0.8em 1em 0.2em;
		color: rgb(var(--ink));
	}
	.post-date {
		display: block;
		padding: 0 1em 1em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	@media (max-width: 480px) {
		.post-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
