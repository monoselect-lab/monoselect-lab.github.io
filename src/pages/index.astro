---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ArticleBanner from '../components/ArticleBanner.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// The brand name returns nothing on any engine yet, so state the site as an
// entity explicitly rather than hoping Google infers it from the <h1>.
const site = Astro.site!.href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			url: site,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			inLanguage: 'ja',
			publisher: { '@id': `${site}#organization` },
		},
		{
			'@type': 'Organization',
			'@id': `${site}#organization`,
			name: SITE_TITLE,
			url: site,
			description: SITE_DESCRIPTION,
		},
	],
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<div class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</div>
			<h2 class="section-title">新着比較記事</h2>
			<ul class="post-grid">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage ? (
									<img src={post.data.heroImage.src} alt="" />
								) : (
									<ArticleBanner title={post.data.title} emoji={post.data.heroEmoji} />
								)}
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home-main {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 2em 1em 3em;
	}
	.hero {
		text-align: center;
		padding: 1em 0 1.6em;
	}
	.hero h1 {
		font-size: 2em;
	}
	.hero p {
		color: rgb(var(--gray));
		font-size: 1.05em;
	}
	.section-title {
		margin-top: 0.5em;
	}
	.post-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.4em;
	}
	.post-grid li a {
		display: block;
		text-decoration: none;
		color: inherit;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		transition: transform 0.15s ease;
	}
	.post-grid li a:hover {
		transform: translateY(-3px);
	}
	.post-grid img {
		width: 100%;
		aspect-ratio: 1200 / 630;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}
	.post-title {
		display: block;
		font-weight: 700;
		padding: 0.8em 1em 0.2em;
		color: rgb(var(--ink));
	}
	.post-date {
		display: block;
		padding: 0 1em 1em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	@media (max-width: 480px) {
		.hero h1 {
			font-size: 1.6em;
		}
		.post-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
